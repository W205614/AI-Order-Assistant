# Non-secret placeholders used only by `docker compose config` in CI.
MYSQL_ROOT_PASSWORD=ci-placeholder-password
LLM_API_KEY=ci-placeholder-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
AGENT_INTERNAL_API_KEY=ci-placeholder-internal-key-at-least-32-characters
JWT_USER_SECRET=ci-placeholder-user-secret-at-least-32-characters
JWT_ADMIN_SECRET=ci-placeholder-admin-secret-at-least-32-characters

DB_APP_PASSWORD=ci-only-application-password
DB_MIGRATION_PASSWORD=ci-only-migration-password
REDIS_GATEWAY_PASSWORD=ci-only-redis-gateway-password
REDIS_AGENT_PASSWORD=ci-only-redis-agent-password
MONITORING_API_KEY=ci-only-monitoring-key-independent-at-least-32-characters
DEMO_CUSTOMER_PASSWORD=ci-only-demo-customer-password
DEMO_OWNER_PASSWORD=ci-only-demo-owner-password
PLATFORM_ADMIN_PASSWORD=ci-only-platform-password
PLATFORM_ADMIN_USERNAME=platform
DEMO_SEED_ENABLED=true
