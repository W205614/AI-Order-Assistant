# Merge the selected values into a private copy of the root .env.example.
# This file is documentation; it contains no usable account, credentials or resource.
PAYMENT_MODE=SIMULATED
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PRIVATE_KEY_PATH=/run/integration-secrets/wechat-private.pem
WECHAT_CERTIFICATE_SERIAL=
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_PATH=/run/integration-secrets/wechat-public.pem
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_BASE_URL=https://orders.example.com
INTEGRATION_SECRETS_DIRECTORY=./.local/integration-secrets

SMS_PROVIDER=disabled
SMS_REGION_ID=cn-hangzhou
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_OTP_TEMPLATE_CODE=
SMS_ORDER_TEMPLATE_CODE=
SMS_READY_TEMPLATE_CODE=
SMS_AFTERSALE_TEMPLATE_CODE=
SMS_EXCEPTION_TEMPLATE_CODE=

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIRECTORY=/app/media
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
AMAP_API_KEY=

CLOUD_DB_URL=jdbc:mysql://mysql.example.com:3306/ai_order_assistant?sslMode=VERIFY_IDENTITY&serverTimezone=Asia/Shanghai
CLOUD_DB_USERNAME=
CLOUD_DB_PASSWORD=
CLOUD_DB_MIGRATION_USERNAME=
CLOUD_DB_MIGRATION_PASSWORD=
CLOUD_REDIS_URL=rediss://redis.example.com:6379/0
REDIS_SSL_CA_CERTS=
CLOUD_CERTS_DIRECTORY=./.local/cloud-certs
CLOUD_JAVA_TOOL_OPTIONS=
CLOUD_REDIS_HOST=redis.example.com
CLOUD_REDIS_PORT=6379
CLOUD_REDIS_GATEWAY_USERNAME=
CLOUD_REDIS_GATEWAY_PASSWORD=
CLOUD_REDIS_AGENT_USERNAME=
CLOUD_REDIS_AGENT_PASSWORD=

# On Linux use the uid/gid of the user who renders the private config file.
OPERATIONS_UID=1000
OPERATIONS_GID=1000
ALERT_SMTP_HOST=smtp.example.com:587
ALERT_SMTP_FROM=
ALERT_SMTP_TO=
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_WEBHOOK_URL=

# Use a separate production directory; do not remove an existing local disable marker.
BACKUP_HEALTH_HOST_DIRECTORY=./.local/cloud-backups/health
BACKUP_DB_HOST=mysql.example.com
BACKUP_DB_PORT=3306
BACKUP_DB_NAME=ai_order_assistant
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=
BACKUP_DB_SSL_CA=
OSS_BACKUP_BUCKET=
OSS_BACKUP_PREFIX=ai-order-backups
OSS_BACKUP_ACCESS_KEY_ID=
OSS_BACKUP_ACCESS_KEY_SECRET=
