MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
DB_APP_PASSWORD=replace-with-a-different-strong-password
DB_MIGRATION_PASSWORD=replace-with-an-independent-migration-password
REDIS_GATEWAY_PASSWORD=replace-with-an-independent-redis-gateway-password
REDIS_AGENT_PASSWORD=replace-with-an-independent-redis-agent-password
MONITORING_API_KEY=replace-with-an-independent-random-monitoring-secret-at-least-32-characters
DEMO_CUSTOMER_PASSWORD=replace-with-a-strong-demo-customer-password
DEMO_OWNER_PASSWORD=replace-with-a-strong-demo-owner-password
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
AGENT_INTERNAL_API_KEY=replace-with-a-random-32-character-or-longer-secret
JWT_USER_SECRET=replace-with-a-different-random-32-character-or-longer-secret
JWT_ADMIN_SECRET=replace-with-another-random-32-character-or-longer-secret
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
DEMO_SEED_ENABLED=true
COOKIE_SECURE=false
FLYWAY_BASELINE_ON_MIGRATE=false
# Optional extra copy destination. A second local directory is not off-host recovery.
BACKUP_EXTRA_DIRECTORY=
BACKUP_DUMP_TIMEOUT_SECONDS=300
BACKUP_COPY_TIMEOUT_SECONDS=120
AGENT_MAX_CONCURRENT=8
AGENT_RATE_LIMIT_PER_MINUTE=30
AGENT_CAMPUS_USER_CONCURRENT=2
AGENT_CAMPUS_DAILY_TOKENS=2000000
CHECKOUT_QUOTE_RETENTION_HOURS=24
CHECKOUT_QUOTE_CLEANUP_BATCH_SIZE=500
CHECKOUT_QUOTE_CLEANUP_DELAY_MS=3600000
# Single-process resource bounds; admission and SSE queues are not shared across replicas.
DB_CONNECTION_TIMEOUT_MS=3000
DB_CONNECT_TIMEOUT_MS=3000
DB_SOCKET_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_SECONDS=8
DB_LOCK_WAIT_SECONDS=5
SSE_SENDER_THREADS=4
SSE_QUEUE_CAPACITY=200
RECOMMEND_MAX_CONCURRENT=2
RECOMMEND_MAX_COMBINATIONS=64
METRICS_QUEUE_CAPACITY=1000
# Complete provider setup and live-verification commands: docs/integrations.md.
PAYMENT_MODE=SIMULATED
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_APP_SECRET_FILE=
WECHAT_PRIVATE_KEY_PATH=/run/integration-secrets/wechat-private.pem
WECHAT_CERTIFICATE_SERIAL=
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_PATH=/run/integration-secrets/wechat-public.pem
WECHAT_API_V3_KEY=
WECHAT_API_V3_KEY_FILE=
WECHAT_NOTIFY_BASE_URL=
INTEGRATION_SECRETS_DIRECTORY=./.local/integration-secrets
SMS_PROVIDER=disabled
SMS_REGION_ID=cn-hangzhou
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_OTP_TEMPLATE_CODE=
SMS_ORDER_TEMPLATE_CODE=
SMS_READY_TEMPLATE_CODE=
SMS_AFTERSALE_TEMPLATE_CODE=
SMS_EXCEPTION_TEMPLATE_CODE=
STORAGE_PROVIDER=local
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
AMAP_API_KEY=
REDIS_SSL_CA_CERTS=
