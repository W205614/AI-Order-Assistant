# Java 点餐后端地址（AI-Order-Assistant 网关 :9090）
JAVA_BASE_URL=http://localhost:9090

# Agent 服务端口（uvicorn --port，注意避开 Windows 被排除端口区间）
AGENT_PORT=8800

# LLM 接入（OpenAI 兼容 API：OpenAI / DeepSeek / 国产大模型 / Ollama 均可）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

# Agent 行为
AGENT_MAX_ITERATIONS=5
FAQ_THRESHOLD=0.35
# Only static, non-transactional FAQ entries may bypass the LLM. Scores come
# from the local keyword + title-bigram retriever, not a vector model.
FAQ_FAST_PATH_THRESHOLD=0.65

# Java 网关与 Agent 使用同一高强度随机值；生产环境不可留空
AGENT_INTERNAL_API_KEY=请替换为至少32位随机字符串
# 允许访问 Agent 的前端域名（通常仅 Java 网关同源页面）
CORS_ORIGINS=http://localhost:9090
AGENT_RATE_LIMIT_PER_MINUTE=30
# 本地开发使用 memory；Docker Compose 使用 redis，并用 Redis 服务器时间实现原子滑动窗口。
RATE_LIMIT_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0
AGENT_RATE_LIMIT_KEY_PREFIX=ai-order-agent:rate
# 指标 JSONL 单文件轮转阈值（字节，最小 65536）
METRICS_MAX_BYTES=5242880
